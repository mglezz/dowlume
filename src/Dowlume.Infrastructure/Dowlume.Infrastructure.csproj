<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Dowlume.Core/Dowlume.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Content Include="obj/native/libdowlume_native.dylib" Link="libdowlume_native.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildMacNativeAdapter" BeforeTargets="PrepareForBuild"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))"
          Inputs="Native/macos.c" Outputs="obj/native/libdowlume_native.dylib">
    <MakeDir Directories="obj/native" />
    <Exec Command="/usr/bin/clang -dynamiclib -arch arm64 -mmacosx-version-min=15.0 -Wall -Wextra -Werror &quot;$(MSBuildProjectDirectory)/Native/macos.c&quot; -o &quot;$(MSBuildProjectDirectory)/obj/native/libdowlume_native.dylib&quot;" />
  </Target>

</Project>
