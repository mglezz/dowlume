<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ac="using:Avalonia.Data.Converters" xmlns:vm="using:Dowlume.App.ViewModels" xmlns:core="using:Dowlume.Core" xmlns:loc="using:Dowlume.App.Localization" x:Class="Dowlume.App.Views.MainWindow" x:DataType="vm:MainViewModel" x:CompileBindings="True" Title="Dowlume" Icon="/Assets/dowlume.ico" Width="1120" Height="820" MinWidth="880" MinHeight="680" Background="{DynamicResource PageBrush}">
  <Window.Resources>
    <loc:LocalizedValueConverter x:Key="LocalizedValue" />
  </Window.Resources>
  <Window.Styles>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource HeadingBrush}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Padding" Value="16,10" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#3456CF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="MinWidth" Value="150" />
      <Setter Property="Padding" Value="20,14" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TabItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TabControl.settingsTabs > TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinWidth" Value="130" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="28">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22">
      <StackPanel Spacing="5">
        <TextBlock Text="Dowlume" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource HeadingBrush}" />
        <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[Yourdownloadsundercontrol]}" Classes="muted" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="{Binding MonitoringLabel}" VerticalAlignment="Center" Classes="muted" />
        <ToggleSwitch AutomationProperties.AutomationId="MonitoringSwitch" IsChecked="{Binding IsMonitoring, Mode=OneWay}" Command="{Binding ToggleMonitoringCommand}" IsEnabled="{Binding IsIdle}" OnContent="{ReflectionBinding $parent[Window].DataContext.Text[MonitoringOn]}" OffContent="{ReflectionBinding $parent[Window].DataContext.Text[MonitoringOff]}" />
        <Button x:Name="HideToTrayButton" IsVisible="False" Content="{ReflectionBinding $parent[Window].DataContext.Text[Hidetotray]}" Click="OnHideToTray" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" IsVisible="{Binding IsPreviewPlatform}" Background="#FFF3CD" Padding="12" Margin="0,0,0,12" CornerRadius="6">
      <TextBlock Text="{Binding PlatformNotice}" TextWrapping="Wrap" Foreground="#594300" />
    </Border>
    <TabControl x:Name="MainTabs" Grid.Row="2">
      <TabItem Header="{ReflectionBinding $parent[Window].DataContext.Text[Overview]}">
        <Grid RowDefinitions="Auto,Auto,*" Margin="0,20,0,0">
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[Managedfiles]}" Classes="muted" />
                <TextBlock Text="{Binding ManagedCount}" FontSize="36" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[Awaitingyourreview]}" Classes="muted" />
                <TextBlock Text="{Binding ReviewCount}" FontSize="36" Foreground="{DynamicResource LinkBrush}" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[Needattention]}" Classes="muted" />
                <TextBlock Text="{Binding AttentionCount}" FontSize="36" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
          </Grid>
          <ScrollViewer Grid.Row="1" MaxHeight="160" Margin="0,20" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Categories}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CategorySummary">
                <StackPanel Spacing="5">
                  <TextBlock Classes="muted" TextTrimming="CharacterEllipsis">
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource LocalizedValue}">
                        <Binding Path="DisplayCategory" />
                        <ReflectionBinding Path="DataContext.Text" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}" />
                        <ReflectionBinding Path="DataContext.Text.Language" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock Text="{Binding Count}" FontSize="22" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </ScrollViewer>
          <Border Grid.Row="2" Classes="card">
            <Grid RowDefinitions="Auto,*">
              <StackPanel Spacing="6" Margin="0,0,0,12">
                <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[Yourorganizedfiles]}" Classes="heading" />
                <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[StartinSettingsthenpreviewyourfolderFilesin]}" TextWrapping="Wrap" Classes="muted" />
              </StackPanel>
              <ListBox Grid.Row="1" ItemsSource="{Binding ManagedFiles}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="core:TrackedFile">
                    <Grid ColumnDefinitions="*,130,140">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CurrentPath}" />
                      <TextBlock Grid.Column="1" Classes="muted" >
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource LocalizedValue}">
                        <Binding Path="DisplayCategory" />
                        <ReflectionBinding Path="DataContext.Text" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}" />
                        <ReflectionBinding Path="DataContext.Text.Language" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                      <TextBlock Grid.Column="2" >
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource LocalizedValue}">
                        <Binding Path="Status" />
                        <ReflectionBinding Path="DataContext.Text" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}" />
                        <ReflectionBinding Path="DataContext.Text.Language" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="{ReflectionBinding $parent[Window].DataContext.Text[Preview]}">
        <Grid RowDefinitions="Auto,*,Auto" Margin="0,20,0,0">
          <StackPanel Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[Seewhatwillchange]}" Classes="heading" />
            <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[Previewcheckscompletedfilesatthetopofyour]}" TextWrapping="Wrap" Classes="muted" />
            <TextBlock Text="{Binding DownloadsPath}" TextWrapping="Wrap" />
            <Expander IsVisible="{Binding OrganizeFolders}" Header="{ReflectionBinding $parent[Window].DataContext.Text[FolderPreview]}">
              <StackPanel Spacing="6">
                <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[FolderPreviewHelp]}" Classes="muted" TextWrapping="Wrap" />
                <ScrollViewer MaxHeight="110"><ItemsControl ItemsSource="{Binding FolderPreview}" /></ScrollViewer>
              </StackPanel>
            </Expander>
          </StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding PreviewItems}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:PreviewItem">
                <Grid ColumnDefinitions="*,*">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding Destination}" Foreground="{DynamicResource LinkBrush}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,16,0,0" IsEnabled="{Binding CanConfigure}">
            <Button Content="{ReflectionBinding $parent[Window].DataContext.Text[Refreshpreview]}" Command="{Binding PreviewCommand}" />
            <Button Content="{ReflectionBinding $parent[Window].DataContext.Text[Organizeandmonitor]}" Classes="primary" Command="{Binding StartCommand}" IsEnabled="{Binding HasPreview}" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="{ReflectionBinding $parent[Window].DataContext.Text[Review]}">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0,20,0,0">
          <StackPanel Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[Alittlespacetodecide]}" Classes="heading" />
            <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[KeepreturnsafiletoitscategorypermanentlySnooze]}" TextWrapping="Wrap" Classes="muted" />
            <TextBlock Text="{Binding RecyclingNotice}" TextWrapping="Wrap" Classes="muted" />
          </StackPanel>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8" Margin="0,0,0,12" IsEnabled="{Binding IsIdle}">
            <TextBox Text="{Binding ReviewSearch}" AutomationProperties.AutomationId="ReviewSearch" PlaceholderText="{ReflectionBinding $parent[Window].DataContext.Text[SearchReviewFiles]}" AutomationProperties.Name="{ReflectionBinding $parent[Window].DataContext.Text[SearchReviewFiles]}" />
            <Button Grid.Column="1" Content="{ReflectionBinding $parent[Window].DataContext.Text[Clear]}" Command="{Binding ClearReviewSearchCommand}" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ReviewResultsLabel}" Classes="muted" />
          </Grid>
          <ListBox Grid.Row="2" ItemsSource="{Binding ReviewFiles}" SelectedItem="{Binding SelectedReview}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:TrackedFile">
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="*,120">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Classes="muted" >
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource LocalizedValue}">
                        <Binding Path="DisplayCategory" />
                        <ReflectionBinding Path="DataContext.Text" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}" />
                        <ReflectionBinding Path="DataContext.Text.Language" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  </Grid>
                  <TextBlock Text="{Binding CurrentPath}" FontSize="12" TextTrimming="CharacterEllipsis" Classes="muted" />
                  <TextBlock FontSize="12" Classes="muted" >
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource LocalizedValue}" ConverterParameter="FirstTracked">
                        <Binding Path="FirstSeenUtc" />
                        <ReflectionBinding Path="DataContext.Text" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}" />
                        <ReflectionBinding Path="DataContext.Text.Language" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="2" Text="{Binding ReviewEmptyMessage}" IsVisible="{Binding IsReviewEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Classes="muted" />
          <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,16,0,0" IsEnabled="{Binding CanReviewSelectedFile}">
            <Button Content="{ReflectionBinding $parent[Window].DataContext.Text[Keep]}" Command="{Binding KeepCommand}" Classes="primary" />
            <Button Content="{ReflectionBinding $parent[Window].DataContext.Text[Snooze7days]}" Command="{Binding SnoozeCommand}" />
            <Button Content="{ReflectionBinding $parent[Window].DataContext.Text[Moveto]}" Command="{Binding MoveCommand}" />
            <Button Content="{ReflectionBinding $parent[Window].DataContext.Text[Recycle]}" Command="{Binding RecycleCommand}" />
            <Button Content="{ReflectionBinding $parent[Window].DataContext.Text[ShowinExplorer]}" Command="{Binding RevealReviewCommand}" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="{ReflectionBinding $parent[Window].DataContext.Text[Activity]}">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="0,20,0,0">
          <StackPanel Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[Aclearrecordofeveryaction]}" Classes="heading" />
            <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[Browseallrecordedactionsnewestfirstacrossyoursaved]}" TextWrapping="Wrap" Classes="muted" />
          </StackPanel>
          <Grid Grid.Row="1" ColumnDefinitions="*,170,170,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,12" IsEnabled="{Binding IsIdle}">
            <TextBox Text="{Binding ActivitySearch}" PlaceholderText="{ReflectionBinding $parent[Window].DataContext.Text[Searchfilenamesorpaths]}" AutomationProperties.Name="{ReflectionBinding $parent[Window].DataContext.Text[Searchactivityfilenamesorpaths]}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SearchActivityCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <ComboBox Grid.Column="1" ItemsSource="{Binding ActivityKinds}" SelectedItem="{Binding SelectedActivityKind}" HorizontalAlignment="Stretch" AutomationProperties.Name="{ReflectionBinding $parent[Window].DataContext.Text[Filteractivitybyaction]}" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding ActivityStatuses}" SelectedItem="{Binding SelectedActivityStatus}" HorizontalAlignment="Stretch" AutomationProperties.Name="{ReflectionBinding $parent[Window].DataContext.Text[Filteractivitybystatus]}" />
            <Button Grid.Column="3" Content="{ReflectionBinding $parent[Window].DataContext.Text[Searchrefresh]}" Command="{Binding SearchActivityCommand}" />
            <Button Grid.Column="4" Content="{ReflectionBinding $parent[Window].DataContext.Text[Clear]}" Command="{Binding ClearActivityFiltersCommand}" />
          </Grid>
          <ListBox Grid.Row="2" ItemsSource="{Binding Activity}" SelectedItem="{Binding SelectedOperation}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:OperationRecord">
                <Grid ColumnDefinitions="160,*,150">
                  <TextBlock Classes="muted" >
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource LocalizedValue}" ConverterParameter="Timestamp">
                        <Binding Path="TimestampUtc" />
                        <ReflectionBinding Path="DataContext.Text" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}" />
                        <ReflectionBinding Path="DataContext.Text.Language" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" >
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource LocalizedValue}" ConverterParameter="Operation">
                        <Binding Path="." />
                        <ReflectionBinding Path="DataContext.Text" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}" />
                        <ReflectionBinding Path="DataContext.Text.Language" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock Grid.Column="2" >
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource LocalizedValue}">
                        <Binding Path="Status" />
                        <ReflectionBinding Path="DataContext.Text" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}" />
                        <ReflectionBinding Path="DataContext.Text.Language" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="2" Text="{ReflectionBinding $parent[Window].DataContext.Text[NooperationsmatchTryanothersearchorclearthe]}" IsVisible="{Binding IsActivityEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" />
          <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0" IsEnabled="{Binding IsIdle}">
            <Button Content="{ReflectionBinding $parent[Window].DataContext.Text[Previous]}" Command="{Binding PreviousActivityPageCommand}" IsEnabled="{Binding HasPreviousActivityPage}" />
            <TextBlock Grid.Column="1" Text="{Binding ActivityPageLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" />
            <Button Grid.Column="2" Content="{ReflectionBinding $parent[Window].DataContext.Text[Next]}" Command="{Binding NextActivityPageCommand}" IsEnabled="{Binding HasNextActivityPage}" />
          </Grid>
          <Border Grid.Row="4" Classes="card" Margin="0,12,0,0" Padding="12">
            <StackPanel Spacing="4">
              <SelectableTextBlock Text="{Binding SelectedOperation.SourcePath}" TextWrapping="Wrap" />
              <SelectableTextBlock Text="{Binding SelectedOperation.DestinationPath}" TextWrapping="Wrap" />
              <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[ObservedFileLocation]}" Classes="muted" IsVisible="{Binding SelectedOperation.ObservedPath, Converter={x:Static ac:StringConverters.IsNotNullOrEmpty}}" />
              <SelectableTextBlock Text="{Binding SelectedOperation.ObservedPath}" TextWrapping="Wrap" />
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" >
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource LocalizedValue}">
                        <Binding Path="SelectedOperation.Error" />
                        <ReflectionBinding Path="DataContext.Text" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}" />
                        <ReflectionBinding Path="DataContext.Text.Language" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="12" Margin="0,12,0,0" IsEnabled="{Binding IsIdle}">
            <Button Content="{ReflectionBinding $parent[Window].DataContext.Text[Undoselectedaction]}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndoSelectedOperation}" />
            <Button Content="{ReflectionBinding $parent[Window].DataContext.Text[Retryinterruptedoperations]}" Command="{Binding RetryRecoveryCommand}" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="{ReflectionBinding $parent[Window].DataContext.Text[Settings]}">
        <Grid RowDefinitions="Auto,*,Auto" Margin="0,12,0,0">
          <TextBlock IsVisible="{Binding IsMonitoring}" Text="{ReflectionBinding $parent[Window].DataContext.Text[SettingsMonitoringHelp]}" TextWrapping="Wrap" Classes="muted"/>
          <TabControl x:Name="SettingsTabs" Grid.Row="1" Classes="settingsTabs" Margin="0,8,0,0">
            <TabItem AutomationProperties.AutomationId="SettingsRulesTab" Header="{ReflectionBinding $parent[Window].DataContext.Text[SettingsFolders]}">
              <ScrollViewer x:Name="SettingsScroll" Margin="0,12,0,0" Padding="0,0,14,0">
                <StackPanel Spacing="16" IsEnabled="{Binding CanConfigure}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[Downloadsfolder]}" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBox Text="{Binding DownloadsPath}" PlaceholderText="{ReflectionBinding $parent[Window].DataContext.Text[Choosealocalfolder]}"/>
                      <Button Grid.Column="1" Content="{ReflectionBinding $parent[Window].DataContext.Text[Browse]}" Command="{Binding ChooseFolderCommand}"/>
                    </Grid>
                  </StackPanel>
                  <Border Classes="card">
                    <StackPanel Spacing="12">
                      <TextBlock x:Name="CustomRulesHeading" Text="{ReflectionBinding $parent[Window].DataContext.Text[CustomRulesHeading]}" FontWeight="SemiBold"/>
                      <ItemsControl ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:CategoryRuleViewModel">
                            <Border Margin="0,0,0,6">
                              <Expander IsExpanded="{Binding IsExpanded}" HorizontalAlignment="Stretch">
                                <Expander.Header>
                                  <TextBlock Text="{Binding EditorTitle}" FontWeight="SemiBold"/>
                                </Expander.Header>
                                <StackPanel Spacing="8">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                      <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocalizedValue}">
                                          <Binding Path="DisplayCategory"/>
                                          <ReflectionBinding Path="DataContext.Text" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}"/>
                                          <ReflectionBinding Path="DataContext.Text.Language" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Window}}"/>
                                        </MultiBinding>
                                      </TextBlock.Text>
                                    </TextBlock>
                                    <Button Grid.Column="1" Content="{ReflectionBinding $parent[Window].DataContext.Text[RemoveCustomRule]}" Command="{ReflectionBinding $parent[Window].DataContext.RemoveRuleCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsCustom}"/>
                                  </Grid>
                                  <Grid ColumnDefinitions="*,140" ColumnSpacing="12">
                                    <StackPanel Spacing="4">
                                      <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[Foldername]}"/>
                                      <TextBox Text="{Binding FolderName}" AutomationProperties.Name="{ReflectionBinding $parent[Window].DataContext.Text[Foldername]}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                      <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[Reviewdays]}"/>
                                      <NumericUpDown Value="{Binding ReviewAfterDays}" Minimum="1" Maximum="3650" FormatString="0" AutomationProperties.Name="{ReflectionBinding $parent[Window].DataContext.Text[Reviewdays]}"/>
                                    </StackPanel>
                                  </Grid>
                                  <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
                                    <ComboBox ItemsSource="{Binding MatchOptions}" IsEnabled="{Binding CanChooseMatchKind}" HorizontalAlignment="Stretch" AutomationProperties.Name="{ReflectionBinding $parent[Window].DataContext.Text[RuleMatchMode]}" SelectedItem="{Binding SelectedMatchChoice}">
                                      <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SettingChoice">
                                          <TextBlock Text="{Binding Label}"/>
                                        </DataTemplate>
                                      </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox Grid.Column="1" Text="{Binding Extensions}" IsVisible="{Binding IsExtensionRule}" PlaceholderText=".png, .mov, .mp4" AutomationProperties.Name="{ReflectionBinding $parent[Window].DataContext.Text[Extensionscommaseparated]}"/>
                                    <TextBox Grid.Column="1" Text="{Binding NamePattern}" IsVisible="{Binding IsNameRule}" PlaceholderText="{ReflectionBinding $parent[Window].DataContext.Text[RulePatternExample]}" AutomationProperties.Name="{ReflectionBinding $parent[Window].DataContext.Text[RuleNamePattern]}"/>
                                  </Grid>
                                </StackPanel>
                              </Expander>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button Content="{ReflectionBinding $parent[Window].DataContext.Text[AddCustomRule]}" Command="{Binding AddRuleCommand}"/>
                      <Expander Header="{ReflectionBinding $parent[Window].DataContext.Text[RuleHelpHeading]}" HorizontalAlignment="Stretch">
                        <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[CustomRulesHelp]}" TextWrapping="Wrap" Classes="muted"/>
                      </Expander>
                      <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[RuleEditScope]}" TextWrapping="Wrap" Classes="muted"/>
                    </StackPanel>
                  </Border>
                  <StackPanel Spacing="8">
                    <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[Excludedextensions]}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding ExcludedExtensions}" PlaceholderText="{ReflectionBinding $parent[Window].DataContext.Text[Forexamplelogbak]}"/>
                    <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[BrowserpartialdownloadsarealwaysexcludedUnrecognizedextensionsgo]}" Classes="muted" TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem AutomationProperties.AutomationId="SettingsAutomationTab" Header="{ReflectionBinding $parent[Window].DataContext.Text[SettingsAutomation]}">
              <ScrollViewer x:Name="AutomationScroll" Margin="0,12,0,0" Padding="0,0,14,0">
                <StackPanel Spacing="16" IsEnabled="{Binding CanConfigure}">
                  <CheckBox IsChecked="{Binding ResumeMonitoringOnStartup}" Content="{ReflectionBinding $parent[Window].DataContext.Text[ResumeMonitoring]}"/>
                  <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[ResumeMonitoringHelp]}" Classes="muted" TextWrapping="Wrap"/>
                  <Border Classes="card" IsVisible="{Binding SupportsFileOperations}">
                    <StackPanel Spacing="8">
                      <CheckBox Content="{ReflectionBinding $parent[Window].DataContext.Text[UsePeriodicOrganization]}" IsChecked="{Binding UsePeriodicOrganization}"/>
                      <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[PeriodicOrganizationHelp]}" TextWrapping="Wrap" Classes="muted"/>
                      <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[OrganizationInterval]}" FontWeight="SemiBold"/>
                      <NumericUpDown Value="{Binding OrganizationIntervalMinutes}" IsEnabled="{Binding UsePeriodicOrganization}" Minimum="1" Maximum="1440" FormatString="0" Width="160" HorizontalAlignment="Left" AutomationProperties.Name="{ReflectionBinding $parent[Window].DataContext.Text[OrganizationInterval]}"/>
                    </StackPanel>
                  </Border>
                  <Expander Header="{ReflectionBinding $parent[Window].DataContext.Text[AdvancedFolderSettings]}" HorizontalAlignment="Stretch">
                    <Border Classes="card" IsVisible="{Binding SupportsFileOperations}">
                      <StackPanel Spacing="8">
                        <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[FolderMoveWarning]}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}"/>
                        <CheckBox IsChecked="{Binding OrganizeFolders}" Content="{ReflectionBinding $parent[Window].DataContext.Text[OrganizeFolders]}"/>
                        <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[OrganizeFoldersHelp]}" Classes="muted" TextWrapping="Wrap"/>
                        <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[CollectedFoldersName]}"/>
                        <TextBox Text="{Binding CollectedFoldersName}" IsEnabled="{Binding OrganizeFolders}"/>
                        <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[FolderInterval]}"/>
                        <NumericUpDown Value="{Binding FolderIntervalMinutes}" Minimum="20" Maximum="1440" FormatString="0" IsEnabled="{Binding OrganizeFolders}" Width="160" HorizontalAlignment="Left"/>
                      </StackPanel>
                    </Border>
                  </Expander>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem AutomationProperties.AutomationId="SettingsAppearanceTab" Header="{ReflectionBinding $parent[Window].DataContext.Text[Appearance]}">
              <ScrollViewer x:Name="AppearanceScroll" Margin="0,12,0,0" Padding="0,0,14,0">
                <StackPanel Spacing="16" IsEnabled="{Binding IsIdle}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[Language]}" FontWeight="SemiBold"/>
                    <ComboBox AutomationProperties.AutomationId="LanguageSelector" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" AutomationProperties.Name="{ReflectionBinding $parent[Window].DataContext.Text[Language]}" MinWidth="180"/>
                    <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[LanguagechangesapplyimmediatelyandaresavedautomaticallyFolder]}" TextWrapping="Wrap" Classes="muted"/>
                  </StackPanel>
                  <StackPanel Spacing="6">
                    <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[Appearance]}" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding ThemeOptions}" AutomationProperties.AutomationId="ThemeSelector" AutomationProperties.Name="{ReflectionBinding $parent[Window].DataContext.Text[Appearance]}" MinWidth="180" SelectedItem="{Binding SelectedThemeChoice}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingChoice">
                          <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[AppearanceHelp]}" Classes="muted" TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem AutomationProperties.AutomationId="SettingsApplicationTab" Header="{ReflectionBinding $parent[Window].DataContext.Text[SettingsApplication]}">
              <ScrollViewer x:Name="ApplicationScroll" Margin="0,12,0,0" Padding="0,0,14,0">
                <StackPanel Spacing="16" IsEnabled="{Binding CanConfigure}">
                  <Border Classes="card">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[ApplicationUpdates]}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding CurrentVersion}"/>
                      <TextBlock Text="{Binding UpdateMessage}" TextWrapping="Wrap" Classes="muted"/>
                      <WrapPanel>
                        <Button Content="{ReflectionBinding $parent[Window].DataContext.Text[CheckForUpdates]}" Command="{Binding CheckForUpdatesCommand}" Margin="0,0,8,8"/>
                        <Button Content="{Binding UpdateActionLabel}" Command="{Binding ApplyUpdateCommand}" IsVisible="{Binding HasUpdate}" Margin="0,0,0,8"/>
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                  <StackPanel Spacing="6" IsVisible="{Binding SupportsLoginStartup}">
                    <CheckBox Content="{ReflectionBinding $parent[Window].DataContext.Text[StartDowlumeAtLogin]}" IsChecked="{Binding StartAtLogin, Mode=OneWay}" Command="{Binding ToggleLoginStartupCommand}"/>
                    <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[LoginStartupExplanation]}" TextWrapping="Wrap" Classes="muted"/>
                    <StackPanel Spacing="6" IsVisible="{Binding IsWindows}">
                      <CheckBox AutomationProperties.AutomationId="ShowWindowAtWindowsLogin" Content="{ReflectionBinding $parent[Window].DataContext.Text[ShowWindowAtWindowsLogin]}" IsChecked="{Binding ShowWindowAtWindowsLogin, Mode=OneWay}" Command="{Binding ToggleWindowsLoginWindowCommand}" IsEnabled="{Binding StartAtLogin}"/>
                      <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[WindowsLoginWindowHelp]}" TextWrapping="Wrap" Classes="muted"/>
                    </StackPanel>
                  </StackPanel>
                  <TextBlock IsVisible="{Binding IsMacOS}" Text="{ReflectionBinding $parent[Window].DataContext.Text[MacFolderScope]}" TextWrapping="Wrap" Classes="muted"/>
                  <TextBlock IsVisible="{Binding IsLinux}" Text="{ReflectionBinding $parent[Window].DataContext.Text[LinuxFolderScope]}" TextWrapping="Wrap" Classes="muted"/>
                  <TextBlock Text="{Binding PrivacyNotice}" TextWrapping="Wrap" Classes="muted"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0" ColumnSpacing="12">
            <TextBlock Text="{ReflectionBinding $parent[Window].DataContext.Text[SettingsSaveHelp]}" TextWrapping="Wrap" Classes="muted" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="{ReflectionBinding $parent[Window].DataContext.Text[Savesettings]}" Command="{Binding SaveSettingsCommand}" IsEnabled="{Binding CanConfigure}" Classes="primary"/>
          </Grid>
        </Grid>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="3" Spacing="7" Margin="0,18,0,0">
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Classes="muted" />
      <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" />
    </StackPanel>
  </Grid>
</Window>
